# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored. Never commit real values.

# -------------------------------------------------------------------
# Next.js public variables (safe to expose to browser)
# -------------------------------------------------------------------

# Backend API base URL — no trailing slash
NEXT_PUBLIC_API_URL=http://localhost:8000

# Auth0 — SPA Flow A
# Application: Single Page Application on manage.auth0.com
NEXT_PUBLIC_AUTH0_DOMAIN=your-tenant.auth0.com
NEXT_PUBLIC_AUTH0_CLIENT_ID=your-client-id
# API Identifier (audience) set on the Auth0 API resource
NEXT_PUBLIC_AUTH0_AUDIENCE=https://api.primeassist.com

# -------------------------------------------------------------------
# Server-only variables (never sent to browser)
# -------------------------------------------------------------------

# Azure DevOps PAT — Work Items: Read & Write scope only
# Create at: https://dev.azure.com/PrimusLearningHub/_usersSettings/tokens
AZURE_DEVOPS_PAT=your-pat-here
